package com.example.chatappnative.presentation.main.chat.data.param

enum class TypeMessage(val type: String) {
    TEXT("text"),
    IMAGE("image"),
    VIDEO("video"),
    AUDIO("audio");
    
    companion object {
        fun fromType(type: String): TypeMessage? {
            return entries.find { it.type == type }
        }
    }
}

enum class StatusMessage(val type: String) {
    TYPING("typing"),
    NOT_SENT("not-sent"),
    SENT("sent"),
    READ("read"),
    DELETE("delete");

    companion object {
        fun fromType(type: String): StatusMessage? {
            return entries.find { it.type == type }
        }
    }
}